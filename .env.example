# Ergon Flow project-local environment
# Copy to ".env" and fill only the providers you actually use.

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=ergon-flow
OPENROUTER_SITE_URL=

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Codex CLI
CODEX_COMMAND=codex
CODEX_ARGS=

# Claude Code CLI
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_ARGS=

# OpenClaw CLI / notify
OPENCLAW_COMMAND=openclaw
OPENCLAW_ARGS=

# Optional runtime overrides
ERGON_ROOT_DIR=
ERGON_DB_PATH=
